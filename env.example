# Copy to .env locally, or add each value in Render > Environment.
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
API_KEY=GENERATE_A_LONG_RANDOM_SECRET
WEBSITE_API_URL=https://YOUR-DOMAIN/api/bot.php
DISCORD_CLIENT_ID=YOUR_DISCORD_APPLICATION_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_NEW_DISCORD_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://YOUR-DOMAIN/discord-callback.php
PUBLIC_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
PORT=3000

# Optional
TICKET_CATEGORY_ID=
SUPPORT_ROLE_ID=
